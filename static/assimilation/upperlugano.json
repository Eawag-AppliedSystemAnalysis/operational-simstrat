            "max_offset_h": 1.5
        }
    },
    "sigma_obs": {
        "mixed": 0.299,
        "stratified": 0.586
    },
    "sigma_obs_fit": {
        "fitted_on_series": "temperature_filtered_h06_1d.csv",
        "fitted_by": "generate_sigma (data-assimilation), against inputs/<lake>/ref/T_out.dat"
    },
    "perturbations": {
        "reanalysis_lake": "lugano",
        "fit_window": {
            "start": "2025-01-01",
            "end": "2025-12-31"
