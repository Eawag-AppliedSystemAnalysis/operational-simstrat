{
    "_note": "Data assimilation setup for this lake: observation processing, observation error, forcing perturbation and the runs. Fitted values are written by src/assimilation_tools/*.py --write; see the Data Assimilation section of README.md.",
    "runs": {
        "python_enkf": {
            "engine": "python",
            "algorithm": "EnKF",
            "n_members": 20,
            "inflation": 1.0,
            "sigma_scale": 1.0,
            "rng_seed": 42
        }
    },
    "observations": {
